DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
PROMPT_VERSION=v1
# Optional: estimated LLM prices in CNY per 1M tokens. Leave 0 to only track tokens.
DEEPSEEK_INPUT_COST_PER_1M=0
DEEPSEEK_OUTPUT_COST_PER_1M=0
AMAP_WEB_KEY=your_amap_web_key
VITE_AMAP_JS_KEY=your_amap_js_key
VITE_AMAP_SECURITY_CODE=your_amap_security_code
VITE_API_BASE=

# Observability / offline evaluation
TRACE_DB_PATH=observability.db

# Multi-user auth
# Set REQUIRE_AUTH=true to disable the shared anonymous demo account.
REQUIRE_AUTH=false
USER_DB_PATH=auth.db
# Leave JWT_SECRET empty to auto-generate a local signing key file.
JWT_SECRET=
JWT_TTL_SECONDS=604800
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900

# Async plan tasks
TASK_DB_PATH=tasks.db
TASK_WORKER_COUNT=2
TASK_MAX_RUNNING_PER_USER=2
TASK_SUBMIT_MAX_PER_WINDOW=30
TASK_SUBMIT_WINDOW_SECONDS=3600

# Optional shared cache / cross-worker rate limiting.
# Leave REDIS_URL empty for the single-process in-memory fallback.
REDIS_URL=
REDIS_KEY_PREFIX=atp
